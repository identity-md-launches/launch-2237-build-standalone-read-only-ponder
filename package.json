  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "ponder dev",
    "start": "sh scripts/start.sh",
    "codegen": "ponder codegen",
