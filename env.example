# Copy to .env locally; do not commit .env. No signing key is used.
# Only 46630 (this public trial) or disposable local 31337 are supported.
CHAIN_ID=46630
# Public keyless trial RPC default. May rate-limit or lack old storage. Use an archive-capable provider for reconciliation.
PONDER_RPC_URL_46630=https://rpc.testnet.chain.robinhood.com
# Optional independent archive state RPC for reconciliation; empty uses the indexing RPC.
# If set, both providers must agree on the checkpoint chain/hash before and after the audit.
RECONCILE_STATE_RPC_URL=
# Optional websocket for real-time indexing; leave empty without a supported websocket endpoint.
PONDER_WS_URL_46630=
# Actual non-proxy deployment defaults. Overrides must match the pinned contract implementation.
TOKEN_ADDRESS=0x31339619db548257cE09A76f189b0b1932f5c0cd
TOKEN_START_BLOCK=138710650
ESCROW_ADDRESS=0x06135FF9311eCa80a7484444A552f28fFC660F05
ESCROW_START_BLOCK=138710790
# Empty follows the live head. Set 138754466 to reproduce the supplied fixed example.
END_BLOCK=
# Bounded consecutive log range, 1..1000, automatically shrunk by reconciliation on errors.
RPC_LOG_RANGE=500
# Read-only preflight/status/reconciliation timeout per RPC, 100..60000 ms; retries bounded.
RPC_TIMEOUT_MS=15000
# Retained Ponder reorg rollback window in chain timestamp seconds, 0..600.
REORG_WINDOW_SECONDS=180
# End-of-block checkpoint spacing, 1..100; smaller numbers cost more RPC calls.
CHECKPOINT_INTERVAL=100
# Maximum checkpoint lag allowed for GraphQL and SQL reads. /sync and /snapshot remain diagnostic.
MAX_SERVING_LAG=200
# Required: choose a strong URL-safe password (e.g. a long random hex string); local Compose only.
POSTGRES_PASSWORD=
# Compose database name, used for deliberate restore into a new database.
POSTGRES_DB=rental
# Railway: set a private Postgres service variable reference here; never use a committed credential.
DATABASE_PRIVATE_URL=
# Direct start alternative to DATABASE_PRIVATE_URL; Compose fills this automatically.
DATABASE_URL=
# Namespace prefix (lowercase, <=19 chars); source/deployment fingerprint is always appended.
DATABASE_SCHEMA=rental
# Stable SQL views schema, <=45 chars. 'off' disables view creation.
PONDER_VIEWS_SCHEMA=rental
# Railway provides PORT automatically. Compose fixes the internal container port to 42069.
PORT=42069
# Compose host port; published ONLY on 127.0.0.1.
LOCAL_PORT=42069
# Railway deployment variable: set its healthcheck path to /ready in the UI.
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=3600
# Optional development-only PGlite directory. Production requires PostgreSQL.
PGLITE_DIRECTORY=.ponder/pglite
# Local 31337 fixtures obtain addresses and start blocks from actual deployment receipts.
PONDER_RPC_URL_31337=http://127.0.0.1:8545
PONDER_WS_URL_31337=
